PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# PostgreSQL — local: postgresql://postgres:PASSWORD@localhost:5432/krepton_analytics
# PostgreSQL — Neon: copy from neon.tech dashboard
# Runtime: local owner is fine. Staging should use app_write (see Docs/diploma/DATABASE_ROLES.md).
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/krepton_analytics
# Optional. Superuser/owner for `npm run migrate:up` when DATABASE_URL is app_write.
DATABASE_MIGRATE_URL=

# HMAC secret for portfolio_accounts.owner_token — not a user UUID.
PORTFOLIO_SECRET=change-me-to-a-long-random-string

# Defense stand only (`npm run seed:demo`). Ignored in production. Fallback is DemoPassw0rd!
SEED_DEMO_PASSWORD=

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google Gemini — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Enable Google Search grounding for ticker chat and news briefing (paid Gemini + billing in AI Studio).
# Keep false until billing is configured. Set Project Spend Cap ($5–10) before enabling.
GEMINI_GROUNDING_ENABLED=false

# Google Identity Services — OAuth 2.0 Web Client ID from Google Cloud Console
GOOGLE_CLIENT_ID=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Krepton Analytics <noreply@yourdomain.com>

# Paddle Billing (Merchant of Record). Leave empty to disable checkout; admin grants still work.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENV=sandbox
# $9 monthly recurring price id (pri_..., not the product id).
PADDLE_PLUS_MONTHLY_PRICE_ID=
# $90 yearly recurring price id (pri_..., not the product id).
PADDLE_PLUS_ANNUAL_PRICE_ID=

# Comma-separated emails that can grant complimentary Plus from /admin.
ADMIN_EMAILS=
