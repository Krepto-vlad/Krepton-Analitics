# Copy to `.env` in the repo root before `docker compose up --build`.
# Never commit `.env`. These values are for local Compose only, not Azure.

POSTGRES_DB=krepton_analytics
POSTGRES_USER=krepton
POSTGRES_PASSWORD=local_compose_only
POSTGRES_HOST_PORT=5432

API_HOST_PORT=3001
WEB_HOST_PORT=8080

# Browser origin of the SPA (nginx). Must match CORS. HTTP → cookies are not Secure.
FRONTEND_URL=http://localhost:8080

# Baked into the frontend image at build time (Vite). Rebuild web after changing this.
VITE_API_URL=http://localhost:3001
VITE_GOOGLE_CLIENT_ID=

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PORTFOLIO_SECRET=change-me-to-a-long-random-string

GEMINI_API_KEY=
# Ticker chat + news briefing Google Search. Needs paid Gemini billing. Keep false until then.
GEMINI_GROUNDING_ENABLED=false
GOOGLE_CLIENT_ID=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Krepton Analytics <noreply@krepton.local>
